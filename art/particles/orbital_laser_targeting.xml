<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 1 (mira): feixe fino que desce do céu e só
     toca o chão depois de ~1,5 s. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="500.0"/>
    <uniform name="lifetime" min="1.45" max="1.5"/>

    <uniform name="position.x" min="-0.1" max="0.1"/>
    <uniform name="position.z" min="-0.1" max="0.1"/>
    <constant name="position.y" value="150.0"/>

    <constant name="velocity.y" value="-100.0"/>

    <uniform name="size" min="0.8" max="1.2"/>

    <constant name="color.r" value="4.0"/>
    <constant name="color.g" value="1.6"/>
    <copy name="color.b" from="color.g"/>
</particles>
