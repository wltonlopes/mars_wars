<?xml version="1.0" encoding="utf-8"?>
<!-- Redemoinho: saia de poeira levantada do chão em volta da base. -->
<particles>
    <texture>art/textures/particles/dust_128a.png</texture>
    <blend mode="over"/>
    <use_local_space/>

    <constant name="emissionrate" value="26.0"/>
    <uniform name="lifetime" min="0.8" max="1.3"/>

    <uniform name="position.x" min="-4.5" max="4.5"/>
    <uniform name="position.y" min="0.0" max="0.8"/>
    <uniform name="position.z" min="-4.5" max="4.5"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-3.0" max="3.0"/>
    <uniform name="velocity.y" min="0.3" max="1.2"/>
    <uniform name="velocity.z" min="-3.0" max="3.0"/>
    <uniform name="velocity.angle" min="-3" max="3"/>

    <uniform name="size" min="2.0" max="3.2"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.42" max="0.5"/>
    <uniform name="color.g" min="0.26" max="0.32"/>
    <uniform name="color.b" min="0.16" max="0.2"/>
</particles>
