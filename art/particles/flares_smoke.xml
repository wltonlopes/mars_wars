<?xml version="1.0" encoding="utf-8"?>
<!-- Rastro de fumaça branca dos flares. -->
<particles>
    <texture>art/textures/particles/smoke_128a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="22.0"/>
    <uniform name="lifetime" min="2.5" max="3.5"/>

    <uniform name="position.x" min="-6.0" max="6.0"/>
    <uniform name="position.y" min="-4.0" max="1.0"/>
    <uniform name="position.z" min="-6.0" max="6.0"/>

    <uniform name="velocity.x" min="-2.0" max="2.0"/>
    <uniform name="velocity.y" min="-3.0" max="0.5"/>
    <uniform name="velocity.z" min="-2.0" max="2.0"/>

    <uniform name="size" min="2.5" max="4.0"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.85" max="0.95"/>
    <copy name="color.g" from="color.r"/>
    <copy name="color.b" from="color.r"/>
</particles>
