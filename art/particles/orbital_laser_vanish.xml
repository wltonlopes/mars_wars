<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 4 (sumindo): fio fino que já não toca o chão e
     se recolhe para o céu. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="500.0"/>
    <uniform name="lifetime" min="0.3" max="0.5"/>

    <uniform name="position.x" min="-0.1" max="0.1"/>
    <uniform name="position.z" min="-0.1" max="0.1"/>
    <uniform name="position.y" min="30.0" max="150.0"/>

    <constant name="velocity.y" value="60.0"/>

    <uniform name="size" min="0.5" max="0.9"/>

    <constant name="color.r" value="3.0"/>
    <constant name="color.g" value="1.0"/>
    <copy name="color.b" from="color.g"/>
</particles>
