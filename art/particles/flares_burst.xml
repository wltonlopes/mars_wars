<?xml version="1.0" encoding="utf-8"?>
<!-- Flares despistadores: pontos incandescentes que saem da aeronave em leque
     e caem (AirEvasion; actor props/units/weapons/flares.xml). -->
<particles>
    <texture>art/textures/particles/tracer_glow.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="28.0"/>
    <uniform name="lifetime" min="1.6" max="2.4"/>

    <uniform name="position.x" min="-1.0" max="1.0"/>
    <uniform name="position.y" min="-1.0" max="0.5"/>
    <uniform name="position.z" min="-1.0" max="1.0"/>

    <uniform name="velocity.x" min="-11.0" max="11.0"/>
    <uniform name="velocity.y" min="-3.0" max="3.0"/>
    <uniform name="velocity.z" min="-11.0" max="11.0"/>
    <force y="-7.0"/>

    <uniform name="size" min="1.1" max="1.8"/>
    <constant name="size.growthRate" value="-0.4"/>

    <uniform name="color.r" min="3.0" max="3.4"/>
    <uniform name="color.g" min="2.0" max="2.6"/>
    <uniform name="color.b" min="0.8" max="1.2"/>
</particles>
