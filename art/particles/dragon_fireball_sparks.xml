<?xml version="1.0" encoding="utf-8"?>
<!-- Bio-Dragão do Enxame: faíscas douradas soltas pela bola de fogo. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="35.0"/>
    <uniform name="lifetime" min="0.3" max="0.7"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-1.2" max="1.2"/>
    <uniform name="velocity.y" min="-0.5" max="1.0"/>
    <uniform name="velocity.z" min="-1.2" max="1.2"/>

    <uniform name="size" min="0.1" max="0.2"/>

    <uniform name="color.r" min="1.0" max="1.0"/>
    <uniform name="color.g" min="0.78" max="0.9"/>
    <uniform name="color.b" min="0.25" max="0.4"/>

    <force y="-3.0"/>
</particles>
