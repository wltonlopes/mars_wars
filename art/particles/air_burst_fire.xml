<?xml version="1.0" encoding="utf-8"?>
<!-- Bola de fogo da interceptação: expande em todas as direções. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="160.0"/>
    <uniform name="lifetime" min="0.3" max="0.7"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-9.0" max="9.0"/>
    <uniform name="velocity.y" min="-9.0" max="9.0"/>
    <uniform name="velocity.z" min="-9.0" max="9.0"/>
    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="3.0" max="6.0"/>
    <constant name="size.growthRate" value="4.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.45" max="0.7"/>
    <uniform name="color.b" min="0.15" max="0.3"/>
</particles>
