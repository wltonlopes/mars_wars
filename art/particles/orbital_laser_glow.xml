<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 2: halo vermelho largo em volta do núcleo. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="900.0"/>
    <uniform name="lifetime" min="0.2" max="0.35"/>

    <uniform name="position.x" min="-1.0" max="1.0"/>
    <uniform name="position.z" min="-1.0" max="1.0"/>
    <uniform name="position.y" min="0.0" max="150.0"/>

    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="10.0" max="13.0"/>

    <uniform name="color.r" min="0.9" max="1.2"/>
    <uniform name="color.g" min="0.15" max="0.25"/>
    <copy name="color.b" from="color.g"/>
</particles>
