<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: anel de poeira rasteira que corre até a borda da área de dano. -->
<particles>
    <texture>art/textures/particles/dust_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="450.0"/>
    <uniform name="lifetime" min="0.6" max="0.9"/>

    <uniform name="position.x" min="-1.0" max="1.0"/>
    <uniform name="position.z" min="-1.0" max="1.0"/>
    <constant name="position.y" value="0.4"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-18.0" max="18.0"/>
    <uniform name="velocity.y" min="0.0" max="1.0"/>
    <uniform name="velocity.z" min="-18.0" max="18.0"/>
    <uniform name="velocity.angle" min="-1.5" max="1.5"/>

    <uniform name="size" min="4.0" max="6.0"/>
    <constant name="size.growthRate" value="4.0"/>

    <uniform name="color.r" min="0.62" max="0.72"/>
    <uniform name="color.g" min="0.5" max="0.58"/>
    <uniform name="color.b" min="0.4" max="0.46"/>
</particles>
