<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: chama branco-amarelada dos focos no chão. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="26.0"/>
    <uniform name="lifetime" min="0.5" max="1.0"/>

    <uniform name="position.x" min="-3.0" max="3.0"/>
    <uniform name="position.z" min="-3.0" max="3.0"/>
    <uniform name="position.y" min="0.2" max="1.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-0.6" max="0.6"/>
    <uniform name="velocity.y" min="2.0" max="5.0"/>
    <uniform name="velocity.z" min="-0.6" max="0.6"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="2.0" max="3.5"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.85" max="0.97"/>
    <uniform name="color.b" min="0.55" max="0.75"/>
</particles>
