<?xml version="1.0" encoding="utf-8"?>
<!-- Coluna, núcleo escuro: fumaça densa no centro, mais estreita. -->
<particles>
    <texture>art/textures/particles/smoke_128b.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="40.0"/>
    <uniform name="lifetime" min="3.6" max="4.0"/>

    <uniform name="position.x" min="-2.5" max="2.5"/>
    <uniform name="position.z" min="-2.5" max="2.5"/>
    <constant name="position.y" value="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-0.6" max="0.6"/>
    <uniform name="velocity.y" min="23.0" max="26.0"/>
    <uniform name="velocity.z" min="-0.6" max="0.6"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="7.0" max="10.0"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.14" max="0.22"/>
    <uniform name="color.g" min="0.12" max="0.19"/>
    <uniform name="color.b" min="0.11" max="0.17"/>
</particles>
