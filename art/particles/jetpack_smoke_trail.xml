<?xml version="1.0" encoding="utf-8"?>
<!-- Jetpack: rastro de fumaça cinza que fica no ar atrás do soldado (as
     partículas ficam onde nasceram, então o rastro segue o caminho do voo). -->
<particles>
    <texture>art/textures/particles/smoke_128a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="16.0"/>
    <uniform name="lifetime" min="1.0" max="1.8"/>

    <uniform name="position.y" min="-0.5" max="-0.2"/>
    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.3" max="0.3"/>
    <uniform name="velocity.y" min="-1.6" max="-0.6"/>
    <uniform name="velocity.z" min="-0.3" max="0.3"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="0.35" max="0.55"/>
    <constant name="size.growthRate" value="1.3"/>

    <uniform name="color.r" min="0.5" max="0.6"/>
    <uniform name="color.g" min="0.48" max="0.56"/>
    <uniform name="color.b" min="0.46" max="0.54"/>

    <force y="0.6"/>
</particles>
