<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvem escura que fica no ar depois da interceptação. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>
    <start_full/>

    <constant name="emissionrate" value="30.0"/>
    <uniform name="lifetime" min="2.5" max="4.0"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-3.0" max="3.0"/>
    <uniform name="velocity.y" min="-1.5" max="2.5"/>
    <uniform name="velocity.z" min="-3.0" max="3.0"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="5.0" max="9.0"/>
    <constant name="size.growthRate" value="2.5"/>

    <uniform name="color.r" min="0.18" max="0.28"/>
    <uniform name="color.g" min="0.17" max="0.26"/>
    <uniform name="color.b" min="0.16" max="0.24"/>
</particles>
