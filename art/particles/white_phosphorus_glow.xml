<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: brilho do fragmento incandescente que cai. -->
<particles>
    <texture>art/textures/particles/flame_radiant.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="20.0"/>
    <uniform name="lifetime" min="0.1" max="0.2"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="size" min="2.5" max="3.5"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.97"/>
    <constant name="color.b" value="0.8"/>
</particles>
