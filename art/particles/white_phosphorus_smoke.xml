<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: fumaça branca espessa que sobe dos focos. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="9.0"/>
    <uniform name="lifetime" min="4.0" max="6.5"/>

    <uniform name="position.x" min="-3.0" max="3.0"/>
    <uniform name="position.z" min="-3.0" max="3.0"/>
    <uniform name="position.y" min="0.5" max="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.0" max="1.0"/>
    <uniform name="velocity.y" min="2.0" max="4.5"/>
    <uniform name="velocity.z" min="-1.0" max="1.0"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="4.0" max="6.5"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.9" max="1.0"/>
    <uniform name="color.g" min="0.9" max="1.0"/>
    <uniform name="color.b" min="0.86" max="0.96"/>
</particles>
