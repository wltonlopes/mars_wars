<?xml version="1.0" encoding="utf-8"?>
<!-- Bio-Dragão do Enxame: clarão dourado e estilhaços no impacto. -->
<particles>
    <texture>art/textures/particles/dragon_flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="120.0"/>
    <uniform name="lifetime" min="0.25" max="0.5"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-2.5" max="2.5"/>
    <uniform name="velocity.y" min="0.5" max="3.0"/>
    <uniform name="velocity.z" min="-2.5" max="2.5"/>

    <uniform name="size" min="0.8" max="1.3"/>
    <constant name="size.growthRate" value="0.8"/>

    <uniform name="color.r" min="0.95" max="1.0"/>
    <uniform name="color.g" min="0.72" max="0.86"/>
    <uniform name="color.b" min="0.2" max="0.32"/>
</particles>
