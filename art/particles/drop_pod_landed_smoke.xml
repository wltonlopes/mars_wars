<?xml version="1.0" encoding="utf-8"?>
<!-- Fumaça residual dos exaustores quentes depois do pouso. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="10.0"/>
    <uniform name="lifetime" min="3.0" max="5.0"/>

    <uniform name="position.x" min="-0.3" max="0.3"/>
    <uniform name="position.z" min="-0.3" max="0.3"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.3" max="0.3"/>
    <uniform name="velocity.y" min="0.8" max="1.6"/>
    <uniform name="velocity.z" min="-0.3" max="0.3"/>
    <uniform name="velocity.angle" min="-0.3" max="0.3"/>

    <uniform name="size" min="1.2" max="1.8"/>
    <constant name="size.growthRate" value="1.2"/>

    <uniform name="color.r" min="0.55" max="0.62"/>
    <uniform name="color.g" min="0.52" max="0.58"/>
    <uniform name="color.b" min="0.5" max="0.55"/>
</particles>
