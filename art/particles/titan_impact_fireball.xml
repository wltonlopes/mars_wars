<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: bola de fogo que se abre e sobe. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="160.0"/>
    <uniform name="lifetime" min="0.5" max="1.1"/>

    <uniform name="position.x" min="-2.0" max="2.0"/>
    <uniform name="position.z" min="-2.0" max="2.0"/>
    <uniform name="position.y" min="0.5" max="4.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-6.0" max="6.0"/>
    <uniform name="velocity.y" min="4.0" max="13.0"/>
    <uniform name="velocity.z" min="-6.0" max="6.0"/>
    <uniform name="velocity.angle" min="-1.5" max="1.5"/>

    <uniform name="size" min="6.0" max="10.0"/>
    <constant name="size.growthRate" value="5.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.45" max="0.7"/>
    <uniform name="color.b" min="0.1" max="0.2"/>
</particles>
