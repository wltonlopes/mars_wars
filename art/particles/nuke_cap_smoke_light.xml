<?xml version="1.0" encoding="utf-8"?>
<!-- Chapéu, camada clara: topo e borda externa, iluminados pelo sol; abre mais que as outras. -->
<particles>
    <texture>art/textures/particles/smoke_128d_light.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="20.0"/>
    <uniform name="lifetime" min="9.0" max="13.0"/>

    <uniform name="position.x" min="-16.0" max="16.0"/>
    <uniform name="position.z" min="-16.0" max="16.0"/>
    <uniform name="position.y" min="92.0" max="106.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-7.5" max="7.5"/>
    <uniform name="velocity.y" min="1.0" max="3.0"/>
    <uniform name="velocity.z" min="-7.5" max="7.5"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="24.0" max="36.0"/>
    <constant name="size.growthRate" value="2.8"/>

    <uniform name="color.r" min="0.7" max="0.86"/>
    <uniform name="color.g" min="0.64" max="0.8"/>
    <uniform name="color.b" min="0.56" max="0.72"/>
</particles>
