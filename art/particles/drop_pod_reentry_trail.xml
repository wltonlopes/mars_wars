<?xml version="1.0" encoding="utf-8"?>
<!-- Rastro de fogo da entrada atmosférica (espaço do mundo: fica para trás e para cima). -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="140.0"/>
    <uniform name="lifetime" min="0.35" max="0.8"/>

    <uniform name="position.x" min="-1.2" max="1.2"/>
    <uniform name="position.z" min="-1.2" max="1.2"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-1.0" max="1.0"/>
    <uniform name="velocity.y" min="0.0" max="2.0"/>
    <uniform name="velocity.z" min="-1.0" max="1.0"/>
    <uniform name="velocity.angle" min="-1.5" max="1.5"/>

    <uniform name="size" min="3.0" max="4.5"/>
    <constant name="size.growthRate" value="2.5"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.38" max="0.5"/>
    <uniform name="color.b" min="0.12" max="0.2"/>
</particles>
