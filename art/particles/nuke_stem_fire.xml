<?xml version="1.0" encoding="utf-8"?>
<!-- Fogo dentro da parte baixa da coluna. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="50.0"/>
    <uniform name="lifetime" min="1.2" max="2.2"/>

    <uniform name="position.x" min="-4.0" max="4.0"/>
    <uniform name="position.z" min="-4.0" max="4.0"/>
    <constant name="position.y" value="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.0" max="1.0"/>
    <uniform name="velocity.y" min="20.0" max="26.0"/>
    <uniform name="velocity.z" min="-1.0" max="1.0"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="8.0" max="12.0"/>
    <constant name="size.growthRate" value="2.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.4" max="0.6"/>
    <uniform name="color.b" min="0.1" max="0.2"/>
</particles>
