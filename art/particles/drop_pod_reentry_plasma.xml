<?xml version="1.0" encoding="utf-8"?>
<!-- Bainha de plasma no escudo térmico durante a entrada atmosférica. -->
<particles>
    <texture>art/textures/particles/flame_radiant.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="90.0"/>
    <uniform name="lifetime" min="0.12" max="0.25"/>

    <uniform name="position.x" min="-1.6" max="1.6"/>
    <uniform name="position.z" min="-1.6" max="1.6"/>
    <uniform name="position.y" min="-0.5" max="0.5"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="6.0" max="8.5"/>
    <constant name="size.growthRate" value="-10.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.62" max="0.78"/>
    <uniform name="color.b" min="0.35" max="0.5"/>
</particles>
