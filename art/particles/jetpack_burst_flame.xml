<?xml version="1.0" encoding="utf-8"?>
<!-- Jetpack: labareda curta e forte no empuxo da decolagem. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="140.0"/>
    <uniform name="lifetime" min="0.1" max="0.2"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-1.2" max="1.2"/>
    <uniform name="velocity.y" min="-14.0" max="-9.0"/>
    <uniform name="velocity.z" min="-1.2" max="1.2"/>
    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="0.45" max="0.7"/>
    <constant name="size.growthRate" value="2.5"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.6" max="0.78"/>
    <uniform name="color.b" min="0.35" max="0.55"/>
</particles>
