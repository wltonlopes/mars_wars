<?xml version="1.0" encoding="utf-8"?>
<!-- Jato do jetpack da Coalizão, para baixo: núcleo azulado e chama curta.
     (A partir do retrofoguete da cápsula, drop_pod_retro_flame.xml, menor.) -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="90.0"/>
    <uniform name="lifetime" min="0.08" max="0.16"/>

    <uniform name="position.x" min="-0.05" max="0.05"/>
    <uniform name="position.z" min="-0.05" max="0.05"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.4" max="0.4"/>
    <uniform name="velocity.y" min="-11.0" max="-7.0"/>
    <uniform name="velocity.z" min="-0.4" max="0.4"/>
    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="0.30" max="0.45"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.75" max="0.9"/>
    <uniform name="color.g" min="0.75" max="0.85"/>
    <constant name="color.b" value="1.0"/>
</particles>
