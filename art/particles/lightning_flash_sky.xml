<?xml version="1.0" encoding="utf-8"?>
<!-- Raio: clarão dentro da nuvem, no alto. -->
<particles>
    <texture>art/textures/particles/tracer_glow.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="40.0"/>
    <uniform name="lifetime" min="0.1" max="0.22"/>

    <uniform name="position.x" min="-8" max="8"/>
    <uniform name="position.y" min="62" max="75"/>
    <uniform name="position.z" min="-8" max="8"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <constant name="velocity.x" value="0"/>
    <constant name="velocity.y" value="0"/>
    <constant name="velocity.z" value="0"/>
    <uniform name="velocity.angle" min="0" max="0"/>

    <uniform name="size" min="55.0" max="80.0"/>
    <constant name="size.growthRate" value="-120.0"/>

    <constant name="color.r" value="0.7"/>
    <constant name="color.g" value="0.75"/>
    <constant name="color.b" value="1.0"/>
</particles>
