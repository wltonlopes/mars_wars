<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: rastro de fumaça branca que cada fragmento deixa ao cair (os tentáculos). -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="28.0"/>
    <uniform name="lifetime" min="3.0" max="4.5"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-0.5" max="0.5"/>
    <uniform name="velocity.y" min="-0.6" max="0.3"/>
    <uniform name="velocity.z" min="-0.5" max="0.5"/>
    <uniform name="velocity.angle" min="-0.3" max="0.3"/>

    <uniform name="size" min="1.8" max="2.6"/>
    <constant name="size.growthRate" value="1.2"/>

    <uniform name="color.r" min="0.9" max="1.0"/>
    <uniform name="color.g" min="0.9" max="1.0"/>
    <uniform name="color.b" min="0.86" max="0.96"/>
</particles>
