<?xml version="1.0" encoding="utf-8"?>
<!-- Poeira do impacto de bala pesada. -->
<particles>
    <texture>art/textures/particles/dust_256a.png</texture>
    <blend mode="over"/>
    <start_full/>

    <constant name="emissionrate" value="60"/>
    <uniform name="lifetime" min="0.5" max="0.9"/>

    <uniform name="position.y" min="0.0" max="0.5"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-2.2" max="2.2"/>
    <uniform name="velocity.y" min="0.5" max="3.3000000000000003"/>
    <uniform name="velocity.z" min="-2.2" max="2.2"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="1.2" max="2.2"/>
    <constant name="size.growthRate" value="3.0"/>

    <uniform name="color.r" min="0.55" max="0.65"/>
    <uniform name="color.g" min="0.40" max="0.48"/>
    <uniform name="color.b" min="0.30" max="0.36"/>

    <force y="-2.0"/>
</particles>
