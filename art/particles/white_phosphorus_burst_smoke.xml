<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: nuvem branca densa que fica no ar depois do estouro. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>
    <start_full/>

    <constant name="emissionrate" value="45.0"/>
    <uniform name="lifetime" min="5.0" max="8.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-5.0" max="5.0"/>
    <uniform name="velocity.y" min="-2.0" max="2.5"/>
    <uniform name="velocity.z" min="-5.0" max="5.0"/>
    <uniform name="velocity.angle" min="-0.3" max="0.3"/>

    <uniform name="size" min="8.0" max="13.0"/>
    <constant name="size.growthRate" value="2.5"/>

    <uniform name="color.r" min="0.9" max="1.0"/>
    <uniform name="color.g" min="0.9" max="1.0"/>
    <uniform name="color.b" min="0.86" max="0.96"/>
</particles>
