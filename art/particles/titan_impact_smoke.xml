<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: coluna de fumaça escura que fica sobre a cratera. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="50.0"/>
    <uniform name="lifetime" min="3.5" max="5.5"/>

    <uniform name="position.x" min="-3.0" max="3.0"/>
    <uniform name="position.z" min="-3.0" max="3.0"/>
    <uniform name="position.y" min="0.5" max="2.5"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.5" max="1.5"/>
    <uniform name="velocity.y" min="3.5" max="8.0"/>
    <uniform name="velocity.z" min="-1.5" max="1.5"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="6.0" max="9.0"/>
    <constant name="size.growthRate" value="2.0"/>

    <uniform name="color.r" min="0.2" max="0.3"/>
    <uniform name="color.g" min="0.17" max="0.25"/>
    <uniform name="color.b" min="0.15" max="0.22"/>
</particles>
