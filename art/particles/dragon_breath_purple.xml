<?xml version="1.0" encoding="utf-8"?>
<!-- Bio-Dragão do Enxame: labaredas roxas saindo da boca no cuspe de fogo. -->
<particles>
    <texture>art/textures/particles/dragon_flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="70.0"/>
    <uniform name="lifetime" min="0.35" max="0.7"/>

    <uniform name="position.x" min="-0.15" max="0.15"/>
    <uniform name="position.z" min="-0.15" max="0.15"/>
    <uniform name="angle" min="-0.6" max="0.6"/>
    <uniform name="velocity.x" min="-1.6" max="1.6"/>
    <uniform name="velocity.y" min="0.6" max="2.2"/>
    <uniform name="velocity.z" min="-1.6" max="1.6"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="0.6" max="1.0"/>
    <constant name="size.growthRate" value="1.2"/>

    <uniform name="color.r" min="0.55" max="0.75"/>
    <uniform name="color.g" min="0.08" max="0.22"/>
    <uniform name="color.b" min="0.85" max="1.0"/>

    <force y="1.5"/>
</particles>
