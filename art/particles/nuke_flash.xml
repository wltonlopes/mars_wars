<?xml version="1.0" encoding="utf-8"?>
<!-- Clarão inicial da explosão nuclear: luz branca enorme e curta. -->
<particles>
    <texture>art/textures/particles/flame_radiant.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="60.0"/>
    <uniform name="lifetime" min="0.3" max="0.7"/>

    <uniform name="position.y" min="5.0" max="20.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="size" min="110.0" max="160.0"/>
    <constant name="size.growthRate" value="60.0"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.95"/>
    <constant name="color.b" value="0.8"/>
</particles>
