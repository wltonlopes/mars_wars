<?xml version="1.0" encoding="utf-8"?>
<!-- Raio: faíscas azuladas no ponto atingido. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="150.0"/>
    <uniform name="lifetime" min="0.3" max="0.8"/>

    <uniform name="position.x" min="-1" max="1"/>
    <uniform name="position.y" min="0.3" max="1.0"/>
    <uniform name="position.z" min="-1" max="1"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-9" max="9"/>
    <uniform name="velocity.y" min="3" max="12"/>
    <uniform name="velocity.z" min="-9" max="9"/>
    <uniform name="velocity.angle" min="-6" max="6"/>

    <uniform name="size" min="0.5" max="0.9"/>
    <constant name="size.growthRate" value="0.0"/>

    <constant name="color.r" value="0.75"/>
    <constant name="color.g" value="0.85"/>
    <constant name="color.b" value="1.0"/>

    <force x="0" y="-9.81" z="0"/>
</particles>
