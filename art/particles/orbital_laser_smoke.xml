<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital: fumaça escura subindo em volta do impacto. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="12.0"/>
    <uniform name="lifetime" min="4.0" max="6.0"/>

    <uniform name="position.x" min="-5.0" max="5.0"/>
    <uniform name="position.z" min="-5.0" max="5.0"/>
    <constant name="position.y" value="1.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.5" max="1.5"/>
    <uniform name="velocity.y" min="4.0" max="7.0"/>
    <uniform name="velocity.z" min="-1.5" max="1.5"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="5.0" max="8.0"/>
    <constant name="size.growthRate" value="2.0"/>

    <uniform name="color.r" min="0.2" max="0.3"/>
    <copy name="color.g" from="color.r"/>
    <copy name="color.b" from="color.r"/>
</particles>
