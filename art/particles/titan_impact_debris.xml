<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: estilhaços incandescentes lançados para o alto, que caem em arco. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="300.0"/>
    <uniform name="lifetime" min="0.6" max="1.3"/>

    <uniform name="position.y" min="0.3" max="1.2"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-14.0" max="14.0"/>
    <uniform name="velocity.y" min="10.0" max="26.0"/>
    <uniform name="velocity.z" min="-14.0" max="14.0"/>
    <uniform name="velocity.angle" min="-6.0" max="6.0"/>

    <uniform name="size" min="0.6" max="1.1"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.5" max="0.7"/>
    <constant name="color.b" value="0.2"/>

    <force y="-22.0"/>
</particles>
