<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: clarão branco-amarelado, muito curto. -->
<particles>
    <texture>art/textures/particles/flame_radiant.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="40.0"/>
    <uniform name="lifetime" min="0.12" max="0.28"/>

    <uniform name="position.y" min="1.0" max="3.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="size" min="20.0" max="30.0"/>
    <constant name="size.growthRate" value="35.0"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.9"/>
    <constant name="color.b" value="0.65"/>
</particles>
