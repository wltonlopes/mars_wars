<?xml version="1.0" encoding="utf-8"?>
<!-- Redemoinho: topo aberto e mais claro, que se dissipa. -->
<particles>
    <texture>art/textures/particles/smoke_128d_light.png</texture>
    <blend mode="over"/>
    <use_local_space/>

    <constant name="emissionrate" value="22.0"/>
    <uniform name="lifetime" min="2.0" max="2.8"/>

    <uniform name="position.x" min="-4.0" max="4.0"/>
    <uniform name="position.y" min="11.0" max="22.0"/>
    <uniform name="position.z" min="-4.0" max="4.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.2" max="1.2"/>
    <uniform name="velocity.y" min="2.5" max="4.5"/>
    <uniform name="velocity.z" min="-1.2" max="1.2"/>
    <uniform name="velocity.angle" min="2" max="4"/>

    <uniform name="size" min="5.0" max="7.5"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.78" max="0.86"/>
    <uniform name="color.g" min="0.58" max="0.66"/>
    <uniform name="color.b" min="0.42" max="0.5"/>
</particles>
