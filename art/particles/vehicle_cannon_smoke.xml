<?xml version="1.0" encoding="utf-8"?>
<!-- Fumaça de disparo do canhão das torretas (enquanto atiram). -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="6.0"/>
    <uniform name="lifetime" min="1.8" max="3.0"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.8" max="0.8"/>
    <uniform name="velocity.y" min="0.6" max="1.6"/>
    <uniform name="velocity.z" min="-0.8" max="0.8"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="1.6" max="2.4"/>
    <constant name="size.growthRate" value="1.6"/>

    <uniform name="color.r" min="0.52" max="0.6"/>
    <uniform name="color.g" min="0.48" max="0.55"/>
    <uniform name="color.b" min="0.45" max="0.5"/>
</particles>
