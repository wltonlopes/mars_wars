<?xml version="1.0" encoding="utf-8"?>
<!-- Brilho vermelho no ponto de impacto do laser. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="40.0"/>
    <uniform name="lifetime" min="0.1" max="0.2"/>

    <uniform name="position.y" min="0.8" max="1.4"/>

    <uniform name="size" min="3.0" max="4.5"/>

    <constant name="color.r" value="3.0"/>
    <constant name="color.g" value="1.5"/>
    <copy name="color.b" from="color.g"/>
</particles>
