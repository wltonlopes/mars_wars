<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvem de poeira baixa e larga que fica na base do cogumelo. -->
<particles>
    <texture>art/textures/particles/dust_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="30.0"/>
    <uniform name="lifetime" min="7.0" max="11.0"/>

    <uniform name="position.x" min="-30.0" max="30.0"/>
    <uniform name="position.z" min="-30.0" max="30.0"/>
    <uniform name="position.y" min="0.0" max="4.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-3.0" max="3.0"/>
    <uniform name="velocity.y" min="0.5" max="2.0"/>
    <uniform name="velocity.z" min="-3.0" max="3.0"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="16.0" max="26.0"/>
    <constant name="size.growthRate" value="1.5"/>

    <uniform name="color.r" min="0.5" max="0.62"/>
    <uniform name="color.g" min="0.42" max="0.52"/>
    <uniform name="color.b" min="0.34" max="0.42"/>
</particles>
