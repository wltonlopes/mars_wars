<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do Titan: leque de terra arrancada do chão, que sobe e desaba. -->
<particles>
    <texture>art/textures/particles/dust_128a.png</texture>
    <blend mode="over"/>
    <start_full/>

    <constant name="emissionrate" value="200.0"/>
    <uniform name="lifetime" min="1.0" max="1.6"/>

    <uniform name="position.x" min="-1.5" max="1.5"/>
    <uniform name="position.z" min="-1.5" max="1.5"/>
    <uniform name="position.y" min="0.0" max="1.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-7.0" max="7.0"/>
    <uniform name="velocity.y" min="12.0" max="22.0"/>
    <uniform name="velocity.z" min="-7.0" max="7.0"/>
    <uniform name="velocity.angle" min="-2.0" max="2.0"/>

    <uniform name="size" min="1.5" max="3.0"/>
    <constant name="size.growthRate" value="1.5"/>

    <uniform name="color.r" min="0.36" max="0.46"/>
    <uniform name="color.g" min="0.25" max="0.32"/>
    <uniform name="color.b" min="0.18" max="0.24"/>

    <force y="-18.0"/>
</particles>
