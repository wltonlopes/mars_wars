<?xml version="1.0" encoding="utf-8"?>
<!-- Faíscas do impacto de bala. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="90"/>
    <uniform name="lifetime" min="0.12" max="0.28"/>

    <uniform name="position.y" min="0.2" max="0.8"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-3.5" max="3.5"/>
    <uniform name="velocity.y" min="1.0" max="4.5"/>
    <uniform name="velocity.z" min="-3.5" max="3.5"/>
    <uniform name="velocity.angle" min="-6.0" max="6.0"/>

    <uniform name="size" min="0.2" max="0.4"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.7"/>
    <constant name="color.b" value="0.35"/>

    <force y="-9.81"/>
</particles>
