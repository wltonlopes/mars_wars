<?xml version="1.0" encoding="utf-8"?>
<!-- Bio-Dragão do Enxame: rastro roxo da bola de fogo (fica no caminho). -->
<particles>
    <texture>art/textures/particles/dragon_flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="70.0"/>
    <uniform name="lifetime" min="0.25" max="0.5"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.3" max="0.3"/>
    <uniform name="velocity.y" min="0.2" max="0.8"/>
    <uniform name="velocity.z" min="-0.3" max="0.3"/>

    <uniform name="size" min="0.6" max="0.9"/>
    <constant name="size.growthRate" value="-0.6"/>

    <uniform name="color.r" min="0.55" max="0.75"/>
    <uniform name="color.g" min="0.1" max="0.22"/>
    <uniform name="color.b" min="0.85" max="1.0"/>
</particles>
