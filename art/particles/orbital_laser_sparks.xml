<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 2: faíscas e rocha derretida espirrando. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="150.0"/>
    <uniform name="lifetime" min="0.6" max="1.4"/>

    <uniform name="position.y" min="0.5" max="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-12.0" max="12.0"/>
    <uniform name="velocity.y" min="6.0" max="18.0"/>
    <uniform name="velocity.z" min="-12.0" max="12.0"/>
    <uniform name="velocity.angle" min="-5.0" max="5.0"/>

    <uniform name="size" min="0.4" max="1.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.5" max="0.8"/>
    <uniform name="color.b" min="0.3" max="0.5"/>

    <force y="-12.0"/>
</particles>
