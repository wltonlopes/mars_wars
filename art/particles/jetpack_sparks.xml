<?xml version="1.0" encoding="utf-8"?>
<!-- Jetpack: faíscas que escapam do bocal e caem. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="12.0"/>
    <uniform name="lifetime" min="0.25" max="0.5"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-1.6" max="1.6"/>
    <uniform name="velocity.y" min="-5.0" max="-2.0"/>
    <uniform name="velocity.z" min="-1.6" max="1.6"/>
    <uniform name="velocity.angle" min="-6.0" max="6.0"/>

    <uniform name="size" min="0.08" max="0.16"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.78"/>
    <constant name="color.b" value="0.45"/>

    <force y="-9.81"/>
</particles>
