<?xml version="1.0" encoding="utf-8"?>
<!-- Raio: fumaça escura subindo do ponto atingido. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="12.0"/>
    <uniform name="lifetime" min="2.5" max="4.0"/>

    <uniform name="position.x" min="-2" max="2"/>
    <uniform name="position.y" min="0" max="1"/>
    <uniform name="position.z" min="-2" max="2"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-0.6" max="0.6"/>
    <uniform name="velocity.y" min="1.5" max="3.0"/>
    <uniform name="velocity.z" min="-0.6" max="0.6"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="3.0" max="5.0"/>
    <constant name="size.growthRate" value="1.5"/>

    <uniform name="color.r" min="0.16" max="0.2"/>
    <uniform name="color.g" min="0.15" max="0.18"/>
    <uniform name="color.b" min="0.14" max="0.17"/>
</particles>
