<?xml version="1.0" encoding="utf-8"?>
<!-- Jetpack: rajada de poeira na decolagem e no pouso (o JetPack liga por
     instantes, perto do chão). Anel forte de poeira marciana. -->
<particles>
    <texture>art/textures/particles/dust_256a.png</texture>
    <blend mode="over"/>
    <start_full/>

    <constant name="emissionrate" value="70.0"/>
    <uniform name="lifetime" min="0.9" max="1.6"/>

    <uniform name="position.x" min="-0.3" max="0.3"/>
    <uniform name="position.y" min="0.0" max="0.3"/>
    <uniform name="position.z" min="-0.3" max="0.3"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-6.0" max="6.0"/>
    <uniform name="velocity.y" min="0.3" max="1.8"/>
    <uniform name="velocity.z" min="-6.0" max="6.0"/>
    <uniform name="velocity.angle" min="-0.8" max="0.8"/>

    <uniform name="size" min="0.9" max="1.4"/>
    <constant name="size.growthRate" value="1.8"/>

    <uniform name="color.r" min="0.6" max="0.7"/>
    <uniform name="color.g" min="0.4" max="0.47"/>
    <uniform name="color.b" min="0.28" max="0.34"/>
</particles>
