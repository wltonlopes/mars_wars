<?xml version="1.0" encoding="utf-8"?>
<!-- Faíscas no ponto onde o feixe laser atinge. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="120.0"/>
    <uniform name="lifetime" min="0.2" max="0.5"/>

    <uniform name="position.y" min="0.5" max="1.5"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-6.0" max="6.0"/>
    <uniform name="velocity.y" min="2.0" max="8.0"/>
    <uniform name="velocity.z" min="-6.0" max="6.0"/>
    <uniform name="velocity.angle" min="-4.0" max="4.0"/>

    <uniform name="size" min="0.3" max="0.7"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.3" max="0.6"/>
    <uniform name="color.b" min="0.2" max="0.4"/>

    <force y="-9.81"/>
</particles>
