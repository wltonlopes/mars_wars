<?xml version="1.0" encoding="utf-8"?>
<!-- Rastro de fumaça do míssil interceptador (espaço do mundo: fica para trás). -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="70.0"/>
    <uniform name="lifetime" min="1.0" max="1.8"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-0.4" max="0.4"/>
    <uniform name="velocity.y" min="-0.2" max="0.6"/>
    <uniform name="velocity.z" min="-0.4" max="0.4"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="0.9" max="1.3"/>
    <constant name="size.growthRate" value="1.8"/>

    <uniform name="color.r" min="0.78" max="0.88"/>
    <uniform name="color.g" min="0.78" max="0.88"/>
    <uniform name="color.b" min="0.78" max="0.88"/>
</particles>
