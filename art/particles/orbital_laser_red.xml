<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 2 (força total): núcleo branco-quente de 150 m,
     do céu até o chão. As partículas são fixas ao longo da coluna e vivem
     pouco, então o feixe aparece e some sem atraso. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="3000.0"/>
    <uniform name="lifetime" min="0.15" max="0.25"/>

    <uniform name="position.x" min="-0.4" max="0.4"/>
    <uniform name="position.z" min="-0.4" max="0.4"/>
    <uniform name="position.y" min="0.0" max="150.0"/>

    <uniform name="velocity.y" min="-2.0" max="2.0"/>
    <uniform name="velocity.angle" min="-3.0" max="3.0"/>

    <uniform name="size" min="4.0" max="5.6"/>

    <uniform name="color.r" min="9.8" max="10.0"/>
    <uniform name="color.g" min="6.0" max="7.0"/>
    <copy name="color.b" from="color.g"/>
</particles>
