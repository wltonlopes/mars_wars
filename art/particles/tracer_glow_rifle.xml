<?xml version="1.0" encoding="utf-8"?>
<!-- Brilho do tracer de rifle.
     Emissor em espaço do mundo: as partículas ficam para trás enquanto o
     projétil avança e formam um rastro luminoso curto. -->
<particles>
    <texture>art/textures/particles/tracer_glow.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="140"/>
    <uniform name="lifetime" min="0.05" max="0.09"/>

    <uniform name="size" min="0.9" max="1.2"/>
    <constant name="size.growthRate" value="-9.0"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.72"/>
    <constant name="color.b" value="0.32"/>
</particles>
