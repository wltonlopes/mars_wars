<?xml version="1.0" encoding="utf-8"?>
<!-- Coluna do cogumelo: fumaça que sobe rápido até ~90 m e se dissipa ali. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="70.0"/>
    <uniform name="lifetime" min="3.5" max="4.0"/>

    <uniform name="position.x" min="-5.0" max="5.0"/>
    <uniform name="position.z" min="-5.0" max="5.0"/>
    <constant name="position.y" value="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.2" max="1.2"/>
    <uniform name="velocity.y" min="22.0" max="26.0"/>
    <uniform name="velocity.z" min="-1.2" max="1.2"/>
    <uniform name="velocity.angle" min="-1.0" max="1.0"/>

    <uniform name="size" min="10.0" max="14.0"/>
    <constant name="size.growthRate" value="2.0"/>

    <uniform name="color.r" min="0.38" max="0.5"/>
    <uniform name="color.g" min="0.33" max="0.43"/>
    <uniform name="color.b" min="0.3" max="0.38"/>
</particles>
