<?xml version="1.0" encoding="utf-8"?>
<!-- Fósforo branco: fagulhas que saltam dos focos. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="14.0"/>
    <uniform name="lifetime" min="0.4" max="0.9"/>

    <uniform name="position.x" min="-2.5" max="2.5"/>
    <uniform name="position.z" min="-2.5" max="2.5"/>
    <uniform name="position.y" min="0.2" max="0.8"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-4.0" max="4.0"/>
    <uniform name="velocity.y" min="4.0" max="9.0"/>
    <uniform name="velocity.z" min="-4.0" max="4.0"/>

    <uniform name="size" min="0.35" max="0.6"/>

    <constant name="color.r" value="1.0"/>
    <constant name="color.g" value="0.95"/>
    <constant name="color.b" value="0.8"/>

    <force y="-12.0"/>
</particles>
