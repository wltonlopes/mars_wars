<?xml version="1.0" encoding="utf-8"?>
<!-- Laser orbital, fase 3 (enfraquecendo): coluna inteira, mais fina. -->
<particles>
    <texture>art/textures/particles/fairy_glow_red.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="1500.0"/>
    <uniform name="lifetime" min="0.15" max="0.25"/>

    <uniform name="position.x" min="-0.2" max="0.2"/>
    <uniform name="position.z" min="-0.2" max="0.2"/>
    <uniform name="position.y" min="0.0" max="150.0"/>

    <uniform name="velocity.angle" min="-3.0" max="3.0"/>

    <uniform name="size" min="1.8" max="2.4"/>

    <uniform name="color.r" min="5.0" max="6.0"/>
    <uniform name="color.g" min="2.0" max="2.5"/>
    <copy name="color.b" from="color.g"/>
</particles>
