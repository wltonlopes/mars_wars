<?xml version="1.0" encoding="utf-8"?>
<!-- Destroços incandescentes caindo da interceptação. -->
<particles>
    <texture>art/textures/particles/sparks.png</texture>
    <blend mode="add"/>
    <start_full/>

    <constant name="emissionrate" value="120.0"/>
    <uniform name="lifetime" min="0.8" max="1.6"/>

    <uniform name="angle" min="-3.14" max="3.14"/>
    <uniform name="velocity.x" min="-16.0" max="16.0"/>
    <uniform name="velocity.y" min="-6.0" max="14.0"/>
    <uniform name="velocity.z" min="-16.0" max="16.0"/>
    <uniform name="velocity.angle" min="-5.0" max="5.0"/>

    <uniform name="size" min="0.5" max="1.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.4" max="0.7"/>
    <constant name="color.b" value="0.2"/>

    <force y="-9.81"/>
</particles>
