<?xml version="1.0" encoding="utf-8"?>
<!-- Tempestade de areia: rajadas rápidas rentes ao chão. -->
<particles>
    <texture>art/textures/particles/dust_256a.png</texture>
    <blend mode="over"/>
    <use_local_space/>

    <constant name="emissionrate" value="16.0"/>
    <uniform name="lifetime" min="2.5" max="4.0"/>

    <uniform name="position.x" min="-34" max="34"/>
    <uniform name="position.y" min="0.0" max="3.0"/>
    <uniform name="position.z" min="-34" max="34"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.5" max="1.5"/>
    <uniform name="velocity.y" min="0.0" max="0.6"/>
    <uniform name="velocity.z" min="-15.0" max="-9.0"/>
    <uniform name="velocity.angle" min="-1" max="1"/>

    <uniform name="size" min="5.0" max="9.0"/>
    <constant name="size.growthRate" value="1.2"/>

    <uniform name="color.r" min="0.78" max="0.86"/>
    <uniform name="color.g" min="0.58" max="0.66"/>
    <uniform name="color.b" min="0.42" max="0.5"/>
</particles>
