<?xml version="1.0" encoding="utf-8"?>
<!-- Coluna, véu claro: fumaça mais rala e iluminada por fora da coluna. -->
<particles>
    <texture>art/textures/particles/smoke_128d_light.png</texture>
    <blend mode="over"/>

    <constant name="emissionrate" value="30.0"/>
    <uniform name="lifetime" min="3.4" max="4.0"/>

    <uniform name="position.x" min="-7.0" max="7.0"/>
    <uniform name="position.z" min="-7.0" max="7.0"/>
    <constant name="position.y" value="2.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-2.0" max="2.0"/>
    <uniform name="velocity.y" min="20.0" max="24.0"/>
    <uniform name="velocity.z" min="-2.0" max="2.0"/>
    <uniform name="velocity.angle" min="-0.4" max="0.4"/>

    <uniform name="size" min="12.0" max="16.0"/>
    <constant name="size.growthRate" value="2.4"/>

    <uniform name="color.r" min="0.62" max="0.78"/>
    <uniform name="color.g" min="0.57" max="0.72"/>
    <uniform name="color.b" min="0.5" max="0.64"/>
</particles>
