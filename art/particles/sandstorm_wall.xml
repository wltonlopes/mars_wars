<?xml version="1.0" encoding="utf-8"?>
<!-- Tempestade de areia: paredão de poeira alaranjada que avança. -->
<particles>
    <texture>art/textures/particles/smoke_256a.png</texture>
    <blend mode="over"/>
    <use_local_space/>

    <constant name="emissionrate" value="10.0"/>
    <uniform name="lifetime" min="7.0" max="10.0"/>

    <uniform name="position.x" min="-32" max="32"/>
    <uniform name="position.y" min="2" max="22"/>
    <uniform name="position.z" min="-32" max="32"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-1.0" max="1.0"/>
    <uniform name="velocity.y" min="0.0" max="1.0"/>
    <uniform name="velocity.z" min="-7.0" max="-4.0"/>
    <uniform name="velocity.angle" min="-0.3" max="0.3"/>

    <uniform name="size" min="22.0" max="34.0"/>
    <constant name="size.growthRate" value="1.5"/>

    <uniform name="color.r" min="0.62" max="0.72"/>
    <uniform name="color.g" min="0.38" max="0.46"/>
    <uniform name="color.b" min="0.22" max="0.28"/>
</particles>
