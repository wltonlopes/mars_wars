<?xml version="1.0" encoding="utf-8"?>
<!-- Brilho alaranjado na parte de baixo do chapéu, nos primeiros segundos. -->
<particles>
    <texture>art/textures/particles/flame.png</texture>
    <blend mode="add"/>

    <constant name="emissionrate" value="35.0"/>
    <uniform name="lifetime" min="2.0" max="3.5"/>

    <uniform name="position.x" min="-14.0" max="14.0"/>
    <uniform name="position.z" min="-14.0" max="14.0"/>
    <uniform name="position.y" min="78.0" max="88.0"/>
    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-5.0" max="5.0"/>
    <uniform name="velocity.y" min="0.0" max="2.0"/>
    <uniform name="velocity.z" min="-5.0" max="5.0"/>
    <uniform name="velocity.angle" min="-0.5" max="0.5"/>

    <uniform name="size" min="20.0" max="30.0"/>
    <constant name="size.growthRate" value="3.0"/>

    <constant name="color.r" value="1.0"/>
    <uniform name="color.g" min="0.35" max="0.55"/>
    <uniform name="color.b" min="0.08" max="0.15"/>
</particles>
