<?xml version="1.0" encoding="utf-8"?>
<!-- Impacto do obus mega pesado do Titan: clarão, bola de fogo, onda de
     choque rasteira, terra e estilhaços lançados e uma coluna de fumaça.
     O actor vive pouco (ImpactAnimationLifetime do ataque) para a explosão
     ser um estouro só; as partículas já emitidas seguem até o fim da vida. -->
<actor version="1">
  <group>
    <variant name="Base">
      <particles file="titan_impact_flash.xml"/>
      <props>
        <prop actor="particle/titan_impact_fireball.xml" attachpoint="root"/>
        <prop actor="particle/titan_impact_shockwave.xml" attachpoint="root"/>
        <prop actor="particle/titan_impact_debris.xml" attachpoint="root"/>
        <prop actor="particle/titan_impact_dirt.xml" attachpoint="root"/>
        <prop actor="particle/titan_impact_smoke.xml" attachpoint="root"/>
      </props>
    </variant>
  </group>
  <material>basic_trans.xml</material>
</actor>
