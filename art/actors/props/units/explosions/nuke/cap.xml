    <variant name="Base">
      <particles file="nuke_cap_smoke.xml"/>
      <props>
        <prop actor="particle/nuke_cap_smoke_dark.xml" attachpoint="root"/>
        <prop actor="particle/nuke_cap_smoke_light.xml" attachpoint="root"/>
        <prop actor="particle/nuke_cap_fire.xml" attachpoint="root"/>
      </props>
    </variant>
  </group>
  <material>basic_trans.xml</material>
</actor>
