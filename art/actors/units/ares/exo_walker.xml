<?xml version="1.0" encoding="utf-8"?>
<!-- Exo Walker da Ares: malha, esqueleto, animações e textura de
     tools/imported/import_ares_exo.py (modelo de refs/exo, ver CREDITS.md).
     Walk/Run: passo duplo de 4,42 m (exo 30% maior) -> speed 23. -->
<actor version="1">
  <castshadow/>
  <group>
    <variant frequency="1" name="Base">
      <mesh>skeletal/ares_exo_walker.dae</mesh>
      <animations>
        <animation file="units/ares_exo_walker/idle.dae" name="Idle" speed="100"/>
        <animation file="units/ares_exo_walker/walk.dae" name="Walk" speed="23"/>
        <animation file="units/ares_exo_walker/walk.dae" name="Run" speed="23"/>
        <animation event="0.35" load="0.8" file="units/ares_exo_walker/attack.dae" name="attack_ranged" speed="100"/>
        <animation file="units/ares_exo_walker/death.dae" name="Death" speed="100"/>
      </animations>
      <props>
        <prop actor="props/units/weapons/ammo/tracer_heavy.xml" attachpoint="projectile"/>
      </props>
      <textures>
        <texture file="skeletal/ares/exo_walker.png" name="baseTex"/>
        <texture file="skeletal/ares/exo_walker_norm.png" name="normTex"/>
        <texture file="skeletal/ares/exo_walker_spec.png" name="specTex"/>
      </textures>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="Idle"/>
    <variant name="attack_ranged">
      <props>
        <prop actor="particle/muzzleflash_1.xml" attachpoint="muzzle_l"/>
        <prop actor="particle/muzzleflash_1.xml" attachpoint="muzzle_r"/>
      </props>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="alive"/>
    <variant name="death">
      <props>
        <prop actor="particle/destruction_smoke_small.xml" attachpoint="root"/>
        <prop actor="particle/destruction_dust_small.xml" attachpoint="root"/>
        <prop actor="particle/flame_med.xml" attachpoint="root"/>
      </props>
    </variant>
  </group>
  <material>basic_trans_norm_spec.xml</material>
</actor>
