<?xml version="1.0" encoding="utf-8"?>
<!-- Stalker do Enxame: malha, esqueleto, animações e textura de
     tools/imported/import_swarm_stalker.py (modelo de refs/exo, ver CREDITS.md).
     Walk/Run: 1.58 / 4.47 m por ciclo -> speed 63 / 22. -->
<actor version="1">
  <castshadow/>
  <group>
    <variant frequency="1" name="Base">
      <mesh>skeletal/swarm_stalker.dae</mesh>
      <animations>
        <animation file="units/swarm_stalker/idle.dae" name="Idle" speed="100"/>
        <animation file="units/swarm_stalker/walk.dae" name="Walk" speed="63"/>
        <animation file="units/swarm_stalker/run.dae" name="Run" speed="22"/>
        <animation event="0.5" file="units/swarm_stalker/slash.dae" name="attack_melee" speed="100"/>
        <animation event="0.5" file="units/swarm_stalker/rake.dae" name="attack_melee" speed="100"/>
        <animation file="units/swarm_stalker/death.dae" name="Death" speed="100"/>
      </animations>
      <textures>
        <texture file="skeletal/swarm/stalker.png" name="baseTex"/>
        <texture file="vehicle/flat_norm.png" name="normTex"/>
        <texture file="skeletal/swarm/stalker_spec.png" name="specTex"/>
      </textures>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="alive"/>
    <variant name="death">
      <props>
        <prop actor="props/units/blood_01.xml" attachpoint="root"/>
      </props>
    </variant>
  </group>
  <material>basic_trans_norm_spec.xml</material>
</actor>
