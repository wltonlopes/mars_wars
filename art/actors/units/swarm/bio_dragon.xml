<?xml version="1.0" encoding="utf-8"?>
<!-- Bio-Dragão do Enxame: malha, esqueleto, animações e textura de
     tools/imported/import_swarm_dragon.py (modelo de refs/exo, ver CREDITS.md).
     Walk/Run: 2.46 m por ciclo -> speed 41. -->
<actor version="1">
  <castshadow/>
  <group>
    <variant frequency="1" name="Base">
      <mesh>skeletal/swarm_bio_dragon.dae</mesh>
      <animations>
        <animation file="units/swarm_bio_dragon/idle.dae" name="Idle" speed="100"/>
        <animation file="units/swarm_bio_dragon/walk.dae" name="Walk" speed="41"/>
        <animation file="units/swarm_bio_dragon/walk.dae" name="Run" speed="41"/>
        <animation event="0.5" load="0.5" file="units/swarm_bio_dragon/attack.dae" name="attack_ranged" speed="100"/>
        <animation event="0.5" file="units/swarm_bio_dragon/melee.dae" name="attack_melee" speed="100"/>
        <animation file="units/swarm_bio_dragon/death.dae" name="Death" speed="100"/>
      </animations>
      <textures>
        <texture file="skeletal/swarm/bio_dragon.png" name="baseTex"/>
        <texture file="vehicle/flat_norm.png" name="normTex"/>
        <texture file="skeletal/swarm/bio_dragon_spec.png" name="specTex"/>
      </textures>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="Idle">
      <props>
        <prop actor="particle/dragon_smolder.xml" attachpoint="mouth"/>
      </props>
    </variant>
    <variant name="attack_ranged">
      <props>
        <prop actor="particle/dragon_breath_purple.xml" attachpoint="mouth"/>
        <prop actor="particle/dragon_breath_gold.xml" attachpoint="mouth"/>
        <prop actor="particle/dragon_embers_gold.xml" attachpoint="mouth"/>
      </props>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="alive"/>
    <variant name="death">
      <props>
        <prop actor="props/units/blood_01.xml" attachpoint="root"/>
        <prop actor="particle/dragon_smolder.xml" attachpoint="mouth"/>
      </props>
    </variant>
  </group>
  <material>basic_trans_norm_spec.xml</material>
</actor>
