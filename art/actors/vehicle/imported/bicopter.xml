<?xml version="1.0" encoding="utf-8"?>
<!-- BiCopter: drone de dois rotores; os rotores giram sempre (também parado).
     Malha, esqueleto, animações e texturas: tools/imported/import_bicopter.py
     (modelo de terceiros, ver CREDITS.md). -->
<actor version="1">
	<castshadow/>
	<group>
		<variant frequency="1" name="Base">
			<mesh>vehicle/bicopter.dae</mesh>
			<animations>
				<animation file="vehicle/bicopter/idle.dae" name="Idle" speed="100"/>
				<animation file="vehicle/bicopter/walk.dae" name="Walk" speed="4"/>
				<animation file="vehicle/bicopter/walk.dae" name="Run" speed="4"/>
				<animation file="vehicle/bicopter/death.dae" name="Death" speed="100"/>
			</animations>
			<textures>
				<texture file="vehicle/bicopter.png" name="baseTex"/>
				<texture file="vehicle/flat_norm.png" name="normTex"/>
				<texture file="vehicle/bicopter_spec.png" name="specTex"/>
			</textures>
		</variant>
	</group>
	<group>
		<variant frequency="1" name="Idle"/>
	</group>
	<group>
		<variant frequency="1" name="alive"/>
		<variant name="death">
			<props>
				<prop actor="particle/destruction_smoke_small.xml" attachpoint="root"/>
				<prop actor="particle/destruction_dust_small.xml" attachpoint="root"/>
				<prop actor="particle/flame_med.xml" attachpoint="root"/>
			</props>
		</variant>
	</group>
	<material>basic_trans_norm_spec.xml</material>
</actor>
