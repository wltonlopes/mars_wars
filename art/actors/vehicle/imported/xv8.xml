<?xml version="1.0" encoding="utf-8"?>
<!-- XV8 Crisis: armadura de combate; Walk/Run: um passo duplo = 3.8 m -> speed 26.
     Malha, esqueleto, animações e texturas: tools/imported/import_xv8.py
     (modelo de terceiros, ver CREDITS.md). -->
<actor version="1">
	<castshadow/>
	<group>
		<variant frequency="1" name="Base">
			<mesh>vehicle/xv8.dae</mesh>
			<animations>
				<animation file="vehicle/xv8/idle.dae" name="Idle" speed="100"/>
				<animation file="vehicle/xv8/walk.dae" name="Walk" speed="26"/>
				<animation file="vehicle/xv8/walk.dae" name="Run" speed="26"/>
				<animation event="0.3" file="vehicle/xv8/attack.dae" name="attack_ranged" speed="100"/>
				<animation file="vehicle/xv8/death.dae" name="Death" speed="100"/>
			</animations>
			<textures>
				<texture file="vehicle/xv8.png" name="baseTex"/>
				<texture file="vehicle/xv8_norm.png" name="normTex"/>
				<texture file="vehicle/xv8_spec.png" name="specTex"/>
			</textures>
		</variant>
	</group>
	<group>
		<variant frequency="1" name="Idle"/>
		<variant name="attack_ranged">
			<props>
				<prop actor="particle/muzzleflash_1.xml" attachpoint="muzzle_l"/>
				<prop actor="particle/muzzleflash_1.xml" attachpoint="muzzle_r"/>
			</props>
		</variant>
	</group>
	<group>
		<variant frequency="1" name="alive"/>
		<variant name="death">
			<props>
				<prop actor="particle/destruction_smoke_small.xml" attachpoint="root"/>
				<prop actor="particle/destruction_dust_small.xml" attachpoint="root"/>
				<prop actor="particle/flame_med.xml" attachpoint="root"/>
			</props>
		</variant>
	</group>
	<material>basic_trans_norm_spec.xml</material>
</actor>
