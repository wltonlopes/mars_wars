<?xml version="1.0" encoding="utf-8"?>
<Entity parent="template_structure">

    <Footprint>
        <Square width="4.5" depth="4.5"/>
        <Height>10.0</Height>
    </Footprint>

    <Obstruction>
        <Static width="4.0" depth="4.0"/>
    </Obstruction>

    <Health>
        <!-- Grande quantidade de vida apenas para impedir destruição acidental -->
        <Max>100000</Max>
        <Initial>100000</Initial>

        <!-- Não regenera -->
        <RegenRate>0</RegenRate>
    </Health>

    <Capturable>
        <CapturePoints>2000</CapturePoints>
        <RegenRate>0</RegenRate>
    </Capturable>

    <Identity>

        <GenericName>Control Point</GenericName>

        <SpecificName>Strategic Objective</SpecificName>

        <Classes datatype="tokens">
            ControlPoint
            Wonder
        </Classes>

        <VisibleClasses datatype="tokens">
            ControlPoint
            Wonder
        </VisibleClasses>

        <Tooltip>
            Capture and hold this strategic position.
        </Tooltip>

        <Icon>gaia/special_obelisk.png</Icon>

    </Identity>

    <ControlPoint>
        <Weight>1</Weight>

        <Region>Unknown</Region>

        <DisplayName>Strategic Point</DisplayName>
    </ControlPoint>

    <ProductionQueue disable=""/>
    <Researcher disable=""/>
    <Trainer disable=""/>
    <TerritoryDecay disable=""/>

</Entity>
