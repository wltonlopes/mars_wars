<?xml version="1.0" encoding="utf-8"?>
<Entity parent="template_unit_vehicle">
  <Attack>
    <Ranged>
      <AttackName>AutomaticGun</AttackName>
      <Damage>
        <Hack>0</Hack>
        <Pierce>12</Pierce>
        <Crush>0</Crush>
      </Damage>
      <MaxRange>40</MaxRange>
      <PrepareTime>1500</PrepareTime>
      <RepeatTime>3000</RepeatTime>
      <Projectile>
        <Speed>60</Speed>
        <Spread>2</Spread>
        <Gravity>50</Gravity>
        <FriendlyFire>false</FriendlyFire>
        <LaunchPoint y="3"/>
      </Projectile>
      <PreferredClasses datatype="tokens">
        Ship
        Human
      </PreferredClasses>
    </Ranged>
  </Attack>
  <GarrisonHolder>
    <List datatype="tokens">Support Soldier Dog Relic</List>
  </GarrisonHolder>
  <Identity>
    <GenericName>Land Vehicle</GenericName>
    <!-- Champion + Ranged: a IA (Petra) monta os ataques pedindo unidades
         "FastMoving+Ranged+Champion"; sem essas classes ela nunca treina
         veículos nas garagens. -->
    <Classes datatype="tokens">Champion</Classes>
    <VisibleClasses datatype="tokens">LandVehicle Ranged</VisibleClasses>
  </Identity>
  <Selectable>
    <Overlay>
      <Texture>
        <MainTexture>128x512/cartouche.png</MainTexture>
        <MainTextureMask>128x512/cartouche_mask.png</MainTextureMask>
      </Texture>
    </Overlay>
  </Selectable>
  <UnitMotion>
    <!-- Colisão de veículo (simulation/data/pathfinder.xml): um não entra no outro. -->
    <PassabilityClass>vehicle</PassabilityClass>
    <WalkSpeed>10</WalkSpeed>
    <Acceleration op="mul">2.8</Acceleration>
  </UnitMotion>
  <!-- Ronco do motor enquanto anda (simulation/components/VehicleSound.js). -->
  <!-- Atropelamento (simulation/components/Trample.js): em alta velocidade,
       infantaria inimiga debaixo do casco leva dano e é jogada para o lado. O
       dano cresce com o tamanho do casco (raio do VehicleSeparation / 4,5). -->
  <Trample>
    <!-- Da borda do casco: o veículo desvia da infantaria e passa a uns
         6 m dela; só quem está à frente (a investida). -->
    <Radius>7.0</Radius>
    <FrontOnly>true</FrontOnly>
    <MinSpeedRatio>0.75</MinSpeedRatio>
    <Interval>300</Interval>
    <Cooldown>1500</Cooldown>
    <Damage>
      <Hack>15</Hack>
      <Crush>35</Crush>
    </Damage>
    <Classes datatype="tokens">Human</Classes>
    <RestrictedClasses datatype="tokens">Structure Vehicle Aircraft</RestrictedClasses>
    <ScaleWithHull>4.5</ScaleWithHull>
    <Knockback>5</Knockback>
  </Trample>
  <VehicleSound>
    <MoveSound>actor/vehicle/engine_wheeled.xml</MoveSound>
    <Interval>1250</Interval>
  </VehicleSound>
  <VehicleSeparation>
    <Radius>4.5</Radius>
  </VehicleSeparation>
  <Vision>
    <Range>80</Range>
  </Vision>
</Entity>