<?xml version="1.0" encoding="utf-8"?>
<Entity parent="template_structure_civic_civil_centre">
  <Attack>
    <Ranged>
      <Projectile>
        <ActorName>props/units/weapons/ammo/tracer_heavy.xml</ActorName>
        <GroundLifetime>2</GroundLifetime>
        <ImpactActorName>props/units/weapons/ammo/heavy_impact.xml</ImpactActorName>
        <ImpactAnimationLifetime>0.8</ImpactAnimationLifetime>
      </Projectile>
    </Ranged>
  </Attack>
  <AirSupportProvider>
    <nuke>
      <Cooldown>300</Cooldown>
      <Template>special/nuclear_missile</Template>
      <!-- Liberado só na fase 3 (City Phase). -->
      <RequiredTechnology>phase_city</RequiredTechnology>
    </nuke>
  </AirSupportProvider>
  <Footprint replace="">
    <Circle radius="16.0"/>
    <Height>24.0</Height>
  </Footprint>
  <Identity>
    <Classes datatype="tokens">BattalionResupplyPoint</Classes>
    <Civ>mla</Civ>
    <Icon>structures/cc.png</Icon>  
    </Identity>
  <Obstruction>
    <Static width="31.0" depth="31.0"/>
  </Obstruction>
  <Trainer>
    <Entities datatype="tokens" replace="">
      units/{civ}/drone_kamikaze
      units/{civ}/worker
      units/{civ}/battalion_infantry_rifleman
      units/{civ}/battalion_infantry_snipe
    </Entities>
  </Trainer>
  <VisualActor>
    <Actor>structures/mla/civic_center.xml</Actor>
    <FoundationActor>structures/mars/fndn_mars_8x8.xml</FoundationActor>
  </VisualActor>
  <Sound>
    <SoundGroups>
      <attack_ranged>attack/weapon/machine_gun.xml</attack_ranged>
    </SoundGroups>
  </Sound>
  <!-- População: valor inicial da colônia (sobe com tecnologias). -->
  <Population>
    <Bonus>40</Bonus>
  </Population>
  <Researcher>
    <Technologies datatype="tokens">
      colony_logistics
      orbital_supply_chain
      workforce_training
      automated_workforce
    </Technologies>
  </Researcher>
  <!-- Requisição: o centro de comando rende um pouco com o tempo (os pontos de
       controle do mapa rendem mais, ver template_control_point). -->
  <ResourceTrickle>
    <Rates>
      <requisition>0.2</requisition>
    </Rates>
    <Interval>1000</Interval>
  </ResourceTrickle>
</Entity>
