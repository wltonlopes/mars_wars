<?xml version="1.0" encoding="utf-8"?>
<!-- Esquadrão lança-chamas: líder + 2 lança-chamas. -->
<Entity parent="battalion_profile_assault|units/mcc/flamethrower">
    <BattalionLeader>
        <MemberTemplates>units/mcc/battalion_member_infantry_flamethrower:2</MemberTemplates>
        <MemberRoles>units/mcc/battalion_member_infantry_flamethrower:2:front</MemberRoles>
        <Spacing>5</Spacing>
    </BattalionLeader>
    <!-- O perfil do batalhão (ranged_combat) traz 30 de munição: aqui é o
         combustível do líder lança-chamas. -->
    <Ammo>
        <CurrAmmo>20</CurrAmmo>
        <MaxAmmo>20</MaxAmmo>
        <SwitchToMeleeRange>0</SwitchToMeleeRange>
    </Ammo>
    <Trainer>
        <Entities datatype="tokens">units/mcc/battalion_member_infantry_flamethrower</Entities>
    </Trainer>
    <Identity>
        <GenericName>Flamethrower Squad</GenericName>
        <SelectionGroupName/>
        <Icon>units/squad_flamethrower.png</Icon>
    </Identity>
</Entity>
